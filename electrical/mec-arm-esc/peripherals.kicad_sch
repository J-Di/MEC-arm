	(text "This UART connector is used\nfor either debug, or to \npower and communicate with another \ndevice. Thus, a bridge is needed\nso in the sebug case, 5V is nor provided"
		(exclude_from_sim no)
		(at 110.744 183.642 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3d146692-6048-41e5-9b8b-8a8866246737")
	)
